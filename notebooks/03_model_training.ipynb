{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Entrenamiento y Evaluación de Modelos\n",
    "## Proyecto Final - MIAA 2025 - Universidad ICESI\n",
    "\n",
    "Este notebook contiene el entrenamiento, evaluación y comparación de múltiples modelos de machine learning para resolver el problema planteado."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Configuración e Importación de Librerías"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Importación de librerías\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.metrics import classification_report, confusion_matrix\n",
    "import warnings\n",
    "\n",
    "# Importar módulos del proyecto\n",
    "import sys\n",
    "sys.path.append('../src')\n",
    "from train_model import MLTrainer, get_default_param_grids\n",
    "from data_preprocessing import DataPreprocessor, generate_sample_data\n",
    "from utils import save_results\n",
    "\n",
    "# Configuración\n",
    "warnings.filterwarnings('ignore')\n",
    "plt.style.use('seaborn-v0_8')\n",
    "sns.set_palette(\"husl\")\n",
    "pd.set_option('display.max_columns', None)\n",
    "\n",
    "print(\"✅ Librerías y módulos importados correctamente\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Carga de Datos Procesados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Intentar cargar datos procesados\n",
    "try:\n",
    "    X_train = pd.read_csv('../data/processed/X_train.csv')\n",
    "    X_test = pd.read_csv('../data/processed/X_test.csv')\n",
    "    y_train = pd.read_csv('../data/processed/y_train.csv').squeeze()\n",
    "    y_test = pd.read_csv('../data/processed/y_test.csv').squeeze()\n",
    "    \n",
    "    print(\"✅ Datos procesados cargados desde archivos\")\n",
    "    \nexcept FileNotFoundError:\n",
    "    print(\"⚠️  Archivos de datos procesados no encontrados. Generando y procesando datos de ejemplo...\")\n",
    "    \n",
    "    # Generar datos de ejemplo\n",
    "    df_raw = generate_sample_data(n_samples=1000)\n",
    "    \n",
    "    # Preprocesar datos\n",
    "    preprocessor = DataPreprocessor()\n",
    "    df = preprocessor.handle_missing_values(df_raw)\n",
    "    df = preprocessor.encode_categorical_variables(df, method='onehot')\n",
    "    df = preprocessor.scale_features(df)\n",
    "    \n",
    "    # Separar características y variable objetivo\n",
    "    target_column = 'score'\n",
    "    X = df.drop(columns=[target_column])\n",
    "    y = df[target_column]\n",
    "    \n",
    "    # Convertir a problema de clasificación binaria para este ejemplo\n",
    "    y = (y > y.median()).astype(int)\n",
    "    \n",
    "    # Crear división train/test\n",
    "    X_train, X_test, y_train, y_test = preprocessor.create_train_test_split(X, y)\n",
    "    \n",
    "    print(\"✅ Datos generados y procesados correctamente\")\n",
    "\n",
    "print(f\"\\n📊 INFORMACIÓN DE LOS DATOS:\")\n",
    "print(f\"   • Entrenamiento: {X_train.shape[0]} muestras, {X_train.shape[1]} características\")\n",
    "print(f\"   • Prueba: {X_test.shape[0]} muestras, {X_test.shape[1]} características\")\n",
    "print(f\"   • Variable objetivo: {y_train.dtype}\")\n",
    "print(f\"   • Clases en y_train: {np.unique(y_train)}\")\n",
    "print(f\"   • Distribución y_train: {dict(pd.Series(y_train).value_counts())}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Determinación del Tipo de Problema"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Determinar si es clasificación o regresión\n",
    "if pd.Series(y_train).dtype == 'object' or pd.Series(y_train).nunique() < 10:\n",
    "    task_type = 'classification'\n",
    "    print(f\"🎯 Problema detectado: CLASIFICACIÓN\")\n",
    "    print(f\"   • Número de clases: {pd.Series(y_train).nunique()}\")\n",
    "    print(f\"   • Clases: {np.unique(y_train)}\")\n",
    "else:\n",
    "    task_type = 'regression'\n",
    "    print(f\"🎯 Problema detectado: REGRESIÓN\")\n",
    "    print(f\"   • Rango de valores: [{y_train.min():.2f}, {y_train.max():.2f}]\")\n",
    "    print(f\"   • Media: {y_train.mean():.2f}\")\n",
    "\n",
    "# Visualizar distribución de la variable objetivo\n",
    "plt.figure(figsize=(12, 5))\n",
    "\n",
    "if task_type == 'classification':\n",
    "    plt.subplot(1, 2, 1)\n",
    "    pd.Series(y_train).value_counts().plot(kind='bar')\n",
    "    plt.title('Distribución de Clases - Entrenamiento')\n",
    "    plt.ylabel('Frecuencia')\n",
    "    \n",
    "    plt.subplot(1, 2, 2)\n",
    "    pd.Series(y_test).value_counts().plot(kind='bar')\n",
    "    plt.title('Distribución de Clases - Prueba')\n",
    "    plt.ylabel('Frecuencia')\n",
    "else:\n",
    "    plt.subplot(1, 2, 1)\n",
    "    plt.hist(y_train, bins=30, alpha=0.7, label='Entrenamiento')\n",
    "    plt.title('Distribución Variable Objetivo - Entrenamiento')\n",
    "    plt.xlabel('Valor')\n",
    "    plt.ylabel('Frecuencia')\n",
    "    \n",
    "    plt.subplot(1, 2, 2)\n",
    "    plt.hist(y_test, bins=30, alpha=0.7, label='Prueba', color='orange')\n",
    "    plt.title('Distribución Variable Objetivo - Prueba')\n",
    "    plt.xlabel('Valor')\n",
    "    plt.ylabel('Frecuencia')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Inicialización del Entrenador de ML"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Crear instancia del entrenador\n",
    "trainer = MLTrainer()\n",
    "\n",
    "# Inicializar modelos según el tipo de tarea\n",
    "trainer.initialize_models(task_type=task_type)\n",
    "\n",
    "print(f\"✅ Entrenador inicializado para {task_type.upper()}\")\n",
    "print(f\"📋 Modelos disponibles: {list(trainer.models.keys())}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Entrenamiento de Modelos con Validación Cruzada"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Entrenar todos los modelos con validación cruzada\n",
    "print(\"🚀 Iniciando entrenamiento de modelos...\\n\")\n",
    "\n",
    "cv_results = trainer.train_models(X_train, y_train, cv_folds=5)\n",
    "\n",
    "print(\"\\n✅ Entrenamiento completado\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualizar resultados de validación cruzada\n",
    "models_names = list(cv_results.keys())\n",
    "cv_means = [cv_results[model]['cv_mean'] for model in models_names]\n",
    "cv_stds = [cv_results[model]['cv_std'] for model in models_names]\n",
    "\n",
    "# Crear DataFrame para mejor visualización\n",
    "results_df = pd.DataFrame({\n",
    "    'Model': models_names,\n",
    "    'CV_Mean': cv_means,\n",
    "    'CV_Std': cv_stds\n",
    "}).sort_values('CV_Mean', ascending=False)\n",
    "\n",
    "print(\"=== RESULTADOS DE VALIDACIÓN CRUZADA ===\\n\")\n",
    "print(results_df.to_string(index=False))\n",
    "\n",
    "# Gráfico de resultados\n",
    "plt.figure(figsize=(12, 6))\n",
    "bars = plt.bar(range(len(results_df)), results_df['CV_Mean'], \n",
    "               yerr=results_df['CV_Std'], capsize=5, alpha=0.7)\n",
    "\n",
    "# Colorear la mejor barra\n",
    "bars[0].set_color('gold')\n",
    "bars[0].set_edgecolor('black')\n",
    "bars[0].set_linewidth(2)\n",
    "\n",
    "plt.xticks(range(len(results_df)), results_df['Model'], rotation=45)\n",
    "plt.ylabel('Puntuación de Validación Cruzada')\n",
    "plt.title('Comparación de Modelos - Validación Cruzada')\n",
    "plt.grid(axis='y', alpha=0.3)\n",
    "\n",
    "# Agregar valores sobre las barras\n",
    "for i, (mean, std) in enumerate(zip(results_df['CV_Mean'], results_df['CV_Std'])):\n",
    "    plt.text(i, mean + std + 0.01, f'{mean:.3f}', ha='center', va='bottom')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "best_model_name = results_df.iloc[0]['Model']\n",
    "print(f\"\\n🏆 Mejor modelo: {best_model_name} (Score: {results_df.iloc[0]['CV_Mean']:.4f})\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Evaluación en Conjunto de Prueba"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluar todos los modelos en el conjunto de prueba\n",
    "print(\"🔍 Evaluando modelos en conjunto de prueba...\\n\")\n",
    "\n",
    "test_results = trainer.compare_models(X_test, y_test)\n",
    "\n",
    "print(\"\\n✅ Evaluación en conjunto de prueba completada\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Análisis Detallado del Mejor Modelo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Obtener el mejor modelo\n",
    "best_model = trainer.best_model\n",
    "print(f\"🔬 Análisis detallado del mejor modelo: {best_model_name}\")\n",
    "\n",
    "# Hacer predicciones\n",
    "y_pred = best_model.predict(X_test)\n",
    "\n",
    "if task_type == 'classification':\n",
    "    # Reporte de clasificación detallado\n",
    "    print(\"\\n=== REPORTE DE CLASIFICACIÓN DETALLADO ===\")\n",
    "    print(classification_report(y_test, y_pred))\n",
    "    \n",
    "    # Matriz de confusión mejorada\n",
    "    cm = confusion_matrix(y_test, y_pred)\n",
    "    plt.figure(figsize=(8, 6))\n",
    "    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', \n",
    "                xticklabels=np.unique(y_train), yticklabels=np.unique(y_train))\n",
    "    plt.title(f'Matriz de Confusión - {best_model_name}')\n",
    "    plt.ylabel('Etiqueta Real')\n",
    "    plt.xlabel('Etiqueta Predicha')\n",
    "    \n",
    "    # Añadir porcentajes\n",
    "    total = cm.sum()\n",
    "    for i in range(cm.shape[0]):\n",
    "        for j in range(cm.shape[1]):\n",
    "            plt.text(j + 0.5, i + 0.7, f'({cm[i, j]/total*100:.1f}%)', \n",
    "                    ha='center', va='center', fontsize=10, color='red')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    # Análisis de errores\n",
    "    errors = X_test[y_test != y_pred]\n",
    "    print(f\"\\n📊 Análisis de Errores:\")\n",
    "    print(f\"   • Total de errores: {len(errors)}\")\n",
    "    print(f\"   • Porcentaje de error: {len(errors)/len(y_test)*100:.2f}%\")\n",
    "    \n",
    "else:  # regression\n",
    "    from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n",
    "    \n",
    "    mse = mean_squared_error(y_test, y_pred)\n",
    "    rmse = np.sqrt(mse)\n",
    "    mae = mean_absolute_error(y_test, y_pred)\n",
    "    r2 = r2_score(y_test, y_pred)\n",
    "    \n",
    "    print(f\"\\n📊 Métricas de Regresión:\")\n",
    "    print(f\"   • MSE: {mse:.4f}\")\n",
    "    print(f\"   • RMSE: {rmse:.4f}\")\n",
    "    print(f\"   • MAE: {mae:.4f}\")\n",
    "    print(f\"   • R²: {r2:.4f}\")\n",
    "    \n",
    "    # Gráficos de regresión detallados\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(15, 12))\n",
    "    \n",
    "    # Predicciones vs Reales\n",
    "    axes[0, 0].scatter(y_test, y_pred, alpha=0.6)\n",
    "    axes[0, 0].plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--', lw=2)\n",
    "    axes[0, 0].set_xlabel('Valores Reales')\n",
    "    axes[0, 0].set_ylabel('Predicciones')\n",
    "    axes[0, 0].set_title(f'Predicciones vs Reales\\nR² = {r2:.4f}')\n",
    "    \n",
    "    # Residuos vs Predicciones\n",
    "    residuals = y_test - y_pred\n",
    "    axes[0, 1].scatter(y_pred, residuals, alpha=0.6)\n",
    "    axes[0, 1].axhline(y=0, color='r', linestyle='--')\n",
    "    axes[0, 1].set_xlabel('Predicciones')\n",
    "    axes[0, 1].set_ylabel('Residuos')\n",
    "    axes[0, 1].set_title('Residuos vs Predicciones')\n",
    "    \n",
    "    # Histograma de residuos\n",
    "    axes[1, 0].hist(residuals, bins=30, alpha=0.7)\n",
    "    axes[1, 0].set_xlabel('Residuos')\n",
    "    axes[1, 0].set_ylabel('Frecuencia')\n",
    "    axes[1, 0].set_title('Distribución de Residuos')\n",
    "    \n",
    "    # Q-Q plot para normalidad de residuos\n",
    "    from scipy import stats\n",
    "    stats.probplot(residuals, dist=\"norm\", plot=axes[1, 1])\n",
    "    axes[1, 1].set_title('Q-Q Plot de Residuos')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Importancia de Características"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analizar importancia de características del mejor modelo\n",
    "print(f\"🔍 Analizando importancia de características para {best_model_name}...\")\n",
    "\n",
    "try:\n",
    "    # Obtener nombres reales de las características\n",
    "    feature_names = X_train.columns.tolist()\n",
    "    \n",
    "    if hasattr(best_model, 'feature_importances_'):\n",
    "        # Para modelos basados en árboles\n",
    "        importances = best_model.feature_importances_\n",
    "        importance_df = pd.DataFrame({\n",
    "            'Feature': feature_names,\n",
    "            'Importance': importances\n",
    "        }).sort_values('Importance', ascending=False)\n",
    "        \n",
    "        print(\"\\n=== TOP 15 CARACTERÍSTICAS MÁS IMPORTANTES ===\")\n",
    "        print(importance_df.head(15).to_string(index=False))\n",
    "        \n",
    "        # Gráfico de importancia\n",
    "        plt.figure(figsize=(12, 8))\n",
    "        top_features = importance_df.head(15)\n",
    "        sns.barplot(data=top_features, x='Importance', y='Feature')\n",
    "        plt.title(f'Top 15 Características Más Importantes - {best_model_name}')\n",
    "        plt.xlabel('Importancia')\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "        \n",
    "    elif hasattr(best_model, 'coef_'):\n",
    "        # Para modelos lineales\n",
    "        coef = best_model.coef_\n",
    "        if len(coef.shape) > 1:\n",
    "            # Clasificación multiclase\n",
    "            importance = np.mean(np.abs(coef), axis=0)\n",
    "        else:\n",
    "            importance = np.abs(coef)\n",
    "        \n",
    "        importance_df = pd.DataFrame({\n",
    "            'Feature': feature_names,\n",
    "            'Importance': importance\n",
    "        }).sort_values('Importance', ascending=False)\n",
    "        \n",
    "        print(\"\\n=== TOP 15 CARACTERÍSTICAS MÁS IMPORTANTES (Coeficientes) ===\")\n",
    "        print(importance_df.head(15).to_string(index=False))\n",
    "        \n",
    "        # Gráfico de coeficientes\n",
    "        plt.figure(figsize=(12, 8))\n",
    "        top_features = importance_df.head(15)\n",
    "        sns.barplot(data=top_features, x='Importance', y='Feature')\n",
    "        plt.title(f'Top 15 Coeficientes Más Importantes - {best_model_name}')\n",
    "        plt.xlabel('Importancia (|Coeficiente|)')\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "        \n",
    "    else:\n",
    "        print(f\"⚠️  El modelo {best_model_name} no soporta análisis de importancia de características\")\n",
    "        importance_df = pd.DataFrame()\n",
    "        \n",
    "except Exception as e:\n",
    "    print(f\"❌ Error al analizar importancia de características: {e}\")\n",
    "    importance_df = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Optimización de Hiperparámetros (Opcional)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Optimización de hiperparámetros para el mejor modelo\n",
    "optimize = input(\"¿Deseas optimizar hiperparámetros del mejor modelo? (y/n): \").lower().strip()\n",
    "\n",
    "if optimize == 'y':\n",
    "    print(f\"🔧 Optimizando hiperparámetros para {best_model_name}...\")\n",
    "    \n",
    "    # Obtener grillas de parámetros por defecto\n",
    "    param_grids = get_default_param_grids()\n",
    "    \n",
    "    if best_model_name in param_grids:\n",
    "        param_grid = param_grids[best_model_name]\n",
    "        \n",
    "        # Realizar optimización\n",
    "        optimization_results = trainer.optimize_hyperparameters(\n",
    "            best_model_name, param_grid, X_train, y_train, cv_folds=5\n",
    "        )\n",
    "        \n",
    "        print(f\"\\n✅ Optimización completada\")\n",
    "        print(f\"📊 Mejores parámetros: {optimization_results['best_params']}\")\n",
    "        print(f\"📈 Mejor puntuación CV: {optimization_results['best_score']:.4f}\")\n",
    "        \n",
    "        # Evaluar modelo optimizado\n",
    "        print(f\"\\n🔍 Evaluando modelo optimizado...\")\n",
    "        optimized_metrics = trainer.evaluate_model(\n",
    "            trainer.models[best_model_name], X_test, y_test, f\"{best_model_name} (Optimizado)\"\n",
    "        )\n",
    "        \n",
    "        # Actualizar mejor modelo\n",
    "        trainer.best_model = trainer.models[best_model_name]\n",
    "        \n",
    "    else:\n",
    "        print(f\"⚠️  No hay grilla de parámetros definida para {best_model_name}\")\n",
    "        \n",
    "else:\n",
    "    print(\"⏭️  Saltando optimización de hiperparámetros\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Guardado de Modelos y Resultados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Guardar el mejor modelo\n",
    "trainer.save_model(model_name=None, filepath=f'../models/best_model_{task_type}.joblib')\n",
    "\n",
    "# Guardar todos los modelos entrenados\n",
    "for model_name in trainer.models.keys():\n",
    "    trainer.save_model(model_name, f'../models/{model_name.lower()}_{task_type}.joblib')\n",
    "\n",
    "print(\"✅ Modelos guardados en '../models/'\")\n",
    "\n",
    "# Guardar resultados de evaluación\n",
    "save_results(test_results, f'model_comparison_{task_type}.csv')\n",
    "\n",
    "if 'importance_df' in locals() and not importance_df.empty:\n",
    "    save_results(importance_df, f'feature_importance_{best_model_name}.csv')\n",
    "\n",
    "# Crear resumen de resultados\n",
    "summary = {\n",
    "    'task_type': task_type,\n",
    "    'best_model': best_model_name,\n",
    "    'best_cv_score': results_df.iloc[0]['CV_Mean'],\n",
    "    'dataset_shape': {\n",
    "        'train': X_train.shape,\n",
    "        'test': X_test.shape\n",
    "    },\n",
    "    'models_evaluated': list(trainer.models.keys())\n",
    "}\n",
    "\n",
    "save_results(summary, f'training_summary_{task_type}.csv')\n",
    "\n",
